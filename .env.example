# =============================================================================
# THE OFFICE — Environment Variables
# =============================================================================
# Copy to .env.local for local development. On Vercel these belong in
# Project Settings → Environment Variables. Never commit real keys here.

# --- Email delivery -----------------------------------------------------------
# Web3Forms delivers straight to a Gmail inbox with no verified domain needed.
# The browser posts here directly, so this value is public by design; keep one
# canonical copy (src/lib/site.ts) rather than duplicating it.
# Get a key at: https://web3forms.com
WEB3FORMS_KEY=your-web3forms-access-key

# Optional: Resend API key, only if you want server-side delivery from a
# verified custom domain. https://resend.com
RESEND_API_KEY=

# Recipient for brief submissions.
TO_EMAIL=theofficetechies@gmail.com

# Verified sender in Resend (only used when RESEND_API_KEY is set).
FROM_EMAIL=onboarding@resend.dev

# --- Site ---------------------------------------------------------------------
# Canonical origin used by index.html, robots.txt, the sitemap and every
# per-route canonical tag. Update this when the custom domain goes live:
#   SITE_URL=https://theoffice.studio npm run sitemap
VITE_SITE_URL=https://the-office-test4.vercel.app

# Optional browser-side override for the Web3Forms key (see src/lib/site.ts).
# Leave the line out entirely rather than setting it to an empty value; either
# way the built-in key is used.
VITE_WEB3FORMS_KEY=

# Optional: absolute API origin, if the functions live on a different host.
# Blank means same-origin (/api/...), which is the normal Vercel setup.
VITE_API_URL=

# --- API ----------------------------------------------------------------------
# Comma-separated list of origins allowed to call /api/brief. Vercel preview
# deployments (*.vercel.app) and localhost are permitted automatically.
CORS_ORIGIN=https://the-office-test4.vercel.app
