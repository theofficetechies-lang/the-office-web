# =============================================================================
# THE OFFICE — Environment Variables
# =============================================================================
# Copy to .env.local for local development. On Vercel these belong in
# Project Settings → Environment Variables. Never commit real keys here.

# --- Email delivery -----------------------------------------------------------
# Web3Forms delivers straight to a Gmail inbox with no verified domain needed.
# The browser posts here directly, so this value is public by design; keep one
# canonical copy (src/lib/site.ts) rather than duplicating it.
# Get a key at: https://web3forms.com
WEB3FORMS_KEY=your-web3forms-access-key

# Optional: Resend API key, only if you want server-side delivery from a
# verified custom domain. https://resend.com
RESEND_API_KEY=

# Recipient for brief submissions.
TO_EMAIL=theofficetechies@gmail.com

# Verified sender in Resend (only used when RESEND_API_KEY is set).
FROM_EMAIL=onboarding@resend.dev

# --- Site ---------------------------------------------------------------------
# Canonical origin used by index.html, robots.txt, the sitemap and every
# per-route canonical tag. Update this when the custom domain goes live:
#   SITE_URL=https://www.the-office360.com npm run sitemap
VITE_SITE_URL=https://www.the-office360.com

# Optional browser-side override for the Web3Forms key (see src/lib/site.ts).
# Leave the line out entirely rather than setting it to an empty value; either
# way the built-in key is used.
VITE_WEB3FORMS_KEY=

# Optional: absolute API origin, if the functions live on a different host.
# Blank means same-origin (/api/...), which is the normal Vercel setup.
VITE_API_URL=

# --- Payments (Paystack — Nigeria + global) --------------------------------------
# Paystack public key (client) and secret key (server-side verification).
# Paystack accepts Nigerian cards/bank transfer/USSD and international cards.
# Get yours at https://paystack.com  — until set, the store shows
# "payments being set up".
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Admin panel passcode. There is NO default: when this is empty the admin route
# renders a plain "not configured" page and never checks a passcode, so an
# unset value can never be guessed into access.
#
# This value ships to the browser, so treat it as a door on a public room, not
# as authentication. Real customer accounts are Phase 8 (see D7b in the audit).
VITE_ADMIN_PASSCODE=


# --- Lead storage (Phase 4, D4) ------------------------------------------------
# Postgres (Neon). Without DATABASE_URL, briefs are emailed but NOT stored, and
# the API says so rather than pretending they were saved.
#
#   Neon dashboard -> Connection Details -> copy the `postgres://…` URI
#   npm run db:migrate        # creates the leads table (idempotent)
DATABASE_URL=

# Passcode for /admin/leads and /api/leads. SERVER-side only — never VITE_.
# With it unset the endpoint returns 503 and serves no data; it never falls open.
# This gates a list, not an account: real per-person auth is Phase 8 (D7b).
ADMIN_PASSCODE=

# --- API ----------------------------------------------------------------------
# Comma-separated list of origins allowed to call /api/brief. Vercel preview
# deployments (*.vercel.app) and localhost are permitted automatically.
CORS_ORIGIN=https://www.the-office360.com
