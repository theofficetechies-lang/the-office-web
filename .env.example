# =============================================================================
# THE OFFICE — Environment Variables
# =============================================================================

# Resend API key for sending brief notifications via email.
# Get yours at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recipient email address for brief submissions.
TO_EMAIL=hello@theoffice.studio

# Sender email address (must be a verified domain in Resend).
# Resend's default onboarding address works for testing:
FROM_EMAIL=onboarding@resend.dev

# Optional: Enable email sending in local development.
# Without this, the API logs to console instead of sending.
# ENABLE_DEV_EMAIL=true

# Optional: Override the API base URL for local frontend development.
# VITE_API_URL=http://localhost:3000
